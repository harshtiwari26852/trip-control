PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://<user>:<password>@<host>:27017/trip-planner?ssl=true&replicaSet=<replicaset>&authSource=admin
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_SECURE=false

# AI Layer — Google Gemini (free tier at aistudio.google.com)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash
ENABLE_GEMINI_MAPS_GROUNDING=false

# AI fallback — Groq (used automatically if Gemini hits a quota/rate limit)
# Current production text models are openai/gpt-oss-20b or openai/gpt-oss-120b.
# The pre-2026 llama-3.3-70b-versatile model was retired and returns model_not_found.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Optional integrations — disabled by default (set to true only when needed)
ENABLE_MAPS=false
ENABLE_AERODATABOX=false

# Weather — OpenWeatherMap (free: 60 calls/min at openweathermap.org)
WEATHER_API_KEY=your-weather-key-here

# Flight Availability — AeroDataBox (free/trial plans at rapidapi.com/aedbx-aedbx/api/aerodatabox)
# Used to show live nonstop flight availability between home and destination; no fare pricing.


# Maps — Google Maps Platform (free: $200/month credit at cloud.google.com/maps)
GOOGLE_MAPS_API_KEY=your-google-maps-key-here
